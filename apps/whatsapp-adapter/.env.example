# Telefones autorizados, com país e DDD, somente dígitos.
ALLOWED_CONTACTS=

# Runtime OpenAI-compatible local (Ollama, vLLM ou llama.cpp).
WHATSAPP_INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
WHATSAPP_INFERENCE_MODEL=qwen-whatsapp
WHATSAPP_INFERENCE_TIMEOUT_MS=120000
INFERENCE_API_TOKEN=

# Compatibilidade opcional com as variáveis tradicionais da OpenAI.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Histórico curto persistido por contato e limite de saída do modelo.
# DATA_DIR=data
# WHATSAPP_HISTORY_MAX_MESSAGES=10
# LLM_MAX_OUTPUT_TOKENS=1800

# Sessão de autenticação do WhatsApp. O histórico fica no diretório acima.
WHATSAPP_SESSION_PATH=.baileys_auth

REPLY_TO_DENIED=false
DENIED_MESSAGE=Este número não está autorizado a usar o chat.

PRINT_QR_TERMINAL=true

# silent | fatal | error | warn | info | debug | trace
# BAILEYS_LOG_LEVEL=silent
