# Números autorizados em modo HYBRID (apenas dígitos). Em DB_ONLY use o painel admin / policy.sqlite.
ALLOWED_CONTACTS=

# Política: hybrid (DB + fallback env) | db_only (só SQLite em POLICY_DB_PATH)
# POLICY_SOURCE=hybrid
# POLICY_DB_PATH=   # default: $DATA_DIR/policy.sqlite
# POLICY_CACHE_TTL_MS=60000

# Painel admin local (127.0.0.1). Só sobe se ADMIN_TOKEN estiver definido.
# ADMIN_TOKEN=
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=3847

# Modelos que o admin pode atribuir a cada número (lista separada por vírgula; inclui sempre OPENAI_MODEL)
# ALLOWED_OPENAI_MODELS=gpt-4o-mini,gpt-4o

# Opcional — com chave: conversas livres enriquecidas por IA. Sem chave: modo determinístico (CSV + comandos).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Limites de uso do modelo (opcional)
# LLM_MAX_OUTPUT_TOKENS=1800
# Teto estimado entrada + saída por requisição (trunca histórico se exceder). Omitir = sem teto além da saída.
# LLM_MAX_REQUEST_TOKENS=12000
# Orçamento de total_tokens por contato/dia (0 = ilimitado). Ver notebooks/token_budget_sizing.ipynb.
# LLM_DAILY_TOKEN_BUDGET_PER_USER=0
# Fuso para virada do dia do orçamento (IANA), ex.: America/Sao_Paulo
# LLM_DAILY_BUDGET_TIMEZONE=UTC
# LLM_TIMEOUT_MS=30000
# LLM_LOG_JSON=false

# Caminhos locais
SESSION_PATH=.baileys_auth
DATA_DIR=data

# Mensagens negadas
REPLY_TO_DENIED=false
DENIED_MESSAGE=Este número não está autorizado a usar o agente financeiro.

# QR no terminal (false para desativar)
PRINT_QR_TERMINAL=true

# Log do Baileys (Pino): silent | fatal | error | warn | info | debug | trace
# Omitir = silent (sem JSON do Baileys nem console.error barulhento do libsignal em falhas de decrypt).
# Use warn ou debug para depurar.
# BAILEYS_LOG_LEVEL=silent
