{
  "name": "whatsapp-ai-chat-adapter",
  "version": "1.0.0",
  "description": "Adapter de chat entre WhatsApp e um endpoint OpenAI-compatible",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:tsx": "tsx watch src/index.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx src/scripts/doctor.ts",
    "verify": "npm run lint && npm run build && npm run test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "chat",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.5"
  }
}
