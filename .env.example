# Modelo e artefato
MODEL_BASE_HF_REPO=Qwen/Qwen2.5-7B-Instruct
MODEL_BASE_HF_REVISION=
MODEL_ARTIFACT_HF_REPO=
MODEL_ARTIFACT_HF_REVISION=
MODEL_ARTIFACT_FILENAME=qwen2.5-7b-instruct-Q4_K_M.gguf
MODEL_QUANTIZATION_TYPE=Q4_K_M

# Runtime local
INFERENCE_MODEL_SOURCE=ollama
INFERENCE_MODEL_ALIAS=qwen-whatsapp
OLLAMA_READY_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=15m
INFERENCE_BIND_HOST=127.0.0.1
INFERENCE_PORT=8000
INFERENCE_API_TOKEN=
INFERENCE_TIMEOUT_SECONDS=120
INFERENCE_MAX_CONCURRENT_REQUESTS=1

# Adaptador WhatsApp
WHATSAPP_SESSION_PATH=.baileys_auth
WHATSAPP_INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
WHATSAPP_INFERENCE_MODEL=qwen-whatsapp
WHATSAPP_INFERENCE_TIMEOUT_MS=120000
HISTORY_MAX_MESSAGES=40

# Tokens Hugging Face: configure somente no .env local quando necessários
HF_WRITE_TOKEN=
HF_READ_TOKEN=
